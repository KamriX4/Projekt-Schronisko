# =========================
# PLIKI SYSTEMOWE I EDYTORY
# =========================
.vscode/
.vs/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# =========================
# BACKEND (C# .NET)
# =========================
# Skompilowane pliki (generują się automatycznie przy budowaniu)
bin/
obj/

# Lokalne pliki baz danych SQLite (jeśli używasz SQL Server/LocalDB, te pliki Cię nie dotyczą)
*.db
*.sqlite
*.db-shm
*.db-wal

# Ignorujemy tylko supertajne pliki. 
# appsettings.Development.json ZOSTAŁ USUNIĘTY z ignorowanych, aby inni widzieli ConnectionString!
appsettings.Local.json
secrets.json

# =========================
# FRONTEND (Vue.js / Node.js)
# =========================
# Pobrane biblioteki (ważą setki MB, instalowane przez pnpm install)
node_modules/

# Skompilowana aplikacja gotowa na produkcję (wynik pnpm run build)
dist/
dist-ssr/

# Jeśli używasz pliku .env do przechowywania adresu API (np. VITE_API_URL=https://localhost:7295),
# możesz usunąć z poniższej listy ".env", aby inni nie musieli go ręcznie tworzyć.
.env
.env.local
.env.*.local

# Pliki z logami błędów
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*