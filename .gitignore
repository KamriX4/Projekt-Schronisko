# =========================
# PLIKI SYSTEMOWE I EDYTORY
# =========================
.vscode/
.vs/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# =========================
# BACKEND (C# .NET)
# =========================
# Skompilowane pliki (generują się automatycznie przy budowaniu, nie wrzucamy ich na GitHuba)
bin/
obj/

# Lokalne pliki baz danych (chroni przed nadpisaniem bazy innego dewelopera)
*.db
*.sqlite
*.db-shm
*.db-wal

# Pliki konfiguracyjne, które mogą zawierać lokalne hasła do bazy
appsettings.Development.json
appsettings.Local.json
secrets.json

# =========================
# FRONTEND (Vue.js / Node.js)
# =========================
# Pobrane biblioteki (ważą setki MB i generują się u każdego z pliku package.json komendą npm install)
node_modules/

# Skompilowana aplikacja gotowa na produkcję (wynik npm run build)
dist/
dist-ssr/

# Lokalne zmienne środowiskowe (często trzymają klucze API i hasła)
.env
.env.local
.env.*.local

# Pliki z logami błędów
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*